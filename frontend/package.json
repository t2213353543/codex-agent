{
  "name": "codex-agent-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:management": "node scripts/test-management.mjs",
    "test:browser": "npm run build && node tests/browser.mjs && node tests/charts-browser.mjs && node scripts/screenshot-gallery.mjs",
    "test:modals": "npm run build && node tests/modals-browser.mjs && node scripts/screenshot-gallery.mjs",
    "measure": "node scripts/bundle-size.mjs after"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "1.61.1",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.0.7"
  }
}
